{
  "manifest_version": 3,
  "name": "EchoRead AI - Speechify Voice Reader",
  "version": "1.0.0",
  "description": "Listen to any webpage, article or document with real-time word highlighting, voice controls, and natural speech.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "EchoRead AI - Voice Text-to-Speech"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "css": ["content/floating-widget.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-play": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Play or pause reading the active page or selection"
    },
    "stop-reading": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Stop audio playback"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+O",
        "mac": "Alt+O"
      },
      "description": "Open reading assistant in Chrome Side Panel"
    },
    "open-reader": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "Open full document reader web app"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "reader/*",
        "content/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
